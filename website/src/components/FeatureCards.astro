---
// The landing page's tour of what Prism does. Each card is a labelled block on
// the sheet: a designator, the page it opens, a crop of the real screen and one
// line on what it is for.
import { Image } from 'astro:assets';
import viewing from '../assets/screenshots/ts-pcb.jpg';
import comparing from '../assets/screenshots/design-comparison.jpg';
import commenting from '../assets/screenshots/commenting.jpg';
import releasing from '../assets/screenshots/assembly-assistant.jpg';
import library from '../assets/screenshots/library-manager.jpg';
import simulating from '../assets/screenshots/sim-results.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cards = [
	{ ref: 'U1', path: 'use/viewing-designs', title: 'View designs', text: 'Schematic, board and 3D in the browser, cross-probed.', image: viewing, focus: '62% 42%' },
	{ ref: 'U2', path: 'use/design-comparison', title: 'Compare revisions', text: 'Every change between two commits, one at a time.', image: comparing, focus: '58% 42%' },
	{ ref: 'U3', path: 'use/comments', title: 'Review with comments', text: 'Threads pinned to parts, nets and areas.', image: commenting, focus: '58% 45%' },
	{ ref: 'U4', path: 'use/release-studio', title: 'Release a board', text: 'Manufacturing outputs, sign-off and publishing.', image: releasing, focus: '62% 50%' },
	{ ref: 'U5', path: 'use/library-manager', title: 'Share one library', text: 'Review and release parts, then place them in KiCad.', image: library, focus: '42% 35%' },
	{ ref: 'U6', path: 'use/simulation-studio', title: 'Check power delivery', text: 'DC IR drop on the real copper, rail by rail.', image: simulating, focus: '42% 40%' },
];
---

<div class="cards">
	{
		cards.map((card) => (
			<a class="card" href={`${base}/${card.path}/`}>
				<div class="meta">
					<span class="ref">{card.ref}</span>
					<span class="path">/{card.path}</span>
				</div>
				<div class="crop">
					<Image src={card.image} alt="" widths={[640, 960]} sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 100vw" style={`object-position: ${card.focus}; --focus: ${card.focus}`} />
				</div>
				<div class="text">
					<strong>{card.title}</strong>
					<span>{card.text}</span>
				</div>
			</a>
		))
	}
</div>

<style>
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(17.5rem, 1fr));
		gap: 1px;
		margin-top: 1.25rem;
		border: 1px solid var(--prism-sheet-line);
		background: var(--prism-sheet-line);
	}
	.card {
		display: flex;
		flex-direction: column;
		background: var(--prism-sheet-bg);
		color: inherit;
		text-decoration: none;
		transition: background-color 160ms ease;
	}
	.card:hover {
		background: var(--prism-card-hover);
	}
	.meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.55rem 0.85rem;
		font-family: var(--sl-font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-4);
	}
	.ref {
		color: var(--sl-color-accent-high);
		font-weight: 600;
	}
	.card:hover .path {
		color: var(--sl-color-gray-2);
	}
	.crop {
		position: relative;
		margin: 0 0.85rem;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border: 1px solid var(--prism-sheet-line);
		background: #0b1120;
	}
	.crop :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.8);
		transform-origin: var(--focus, 50% 50%);
		transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.card:hover .crop :global(img) {
		transform: scale(1.9);
	}
	.text {
		display: grid;
		gap: 0.3rem;
		padding: 0.9rem 0.85rem 1.1rem;
	}
	.text strong {
		font-size: 1.02rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}
	.text span {
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}
	.card:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
</style>
