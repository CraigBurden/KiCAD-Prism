{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:prism:schema:prism.system_entry:a0",
    "type": "object",
    "properties": {
        "schema": {
            "type": "string",
            "const": "prism.system_entry.a0",
            "description": "Schema id."
        },
        "source": {
            "$ref": "#/$defs/SystemEntrySource",
            "description": "Where it was published from."
        },
        "document": {
            "$ref": "urn:prism:schema:prism.system:v2",
            "description": "The document at `source.version`."
        },
        "boardSubPorts": {
            "$ref": "urn:prism:schema:prism.board_sub_ports:a0",
            "description": "The board-level sub-ports the document names, as they were."
        },
        "bundle": {
            "$ref": "urn:prism:schema:prism.system_bundle:a0",
            "description": "The system bundle built from exactly these."
        },
        "interface": {
            "$ref": "#/$defs/SystemEntryInterface",
            "description": "The interface its exports make."
        }
    },
    "required": [
        "schema",
        "source",
        "document",
        "boardSubPorts",
        "bundle",
        "interface"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "A published system's frozen payload.",
    "title": "System entry a0",
    "$defs": {
        "SystemEntrySource": {
            "type": "object",
            "properties": {
                "systemId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "description": "The system's id in the workspace it was published from."
                },
                "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "The document version published."
                },
                "snapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "description": "The snapshot holding that version."
                },
                "systemBundleKey": {
                    "$ref": "#/$defs/Sha256Hex",
                    "description": "The key of `bundle`."
                }
            },
            "required": [
                "systemId",
                "version",
                "snapshotId",
                "systemBundleKey"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Where the payload was published from."
        },
        "SystemEntryInterface": {
            "type": "object",
            "properties": {
                "exports": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SystemEntryInterfaceExport"
                    },
                    "description": "The exports, sorted by `id` in code point order."
                }
            },
            "required": [
                "exports"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "The interface a published system offers."
        },
        "Sha256Hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Lowercase hexadecimal SHA-256 digest: exactly 64 characters, no prefix such as `sha256:`."
        },
        "SystemEntryInterfaceExport": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/SystemObjectId",
                    "description": "The export's id: what an endpoint on the placed entry names as its connector."
                },
                "name": {
                    "$ref": "#/$defs/SystemLabel",
                    "description": "The export's name."
                },
                "occurrence": {
                    "$ref": "#/$defs/SystemObjectId",
                    "description": "The occurrence of its site."
                },
                "connector": {
                    "$ref": "#/$defs/Refdes",
                    "description": "The connector of its site."
                },
                "subPort": {
                    "$ref": "#/$defs/SystemSubPortRef",
                    "description": "The sub-port of its site, when the export is one."
                },
                "pins": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SystemEntryInterfacePin"
                    },
                    "description": "Its pins in the site's order: the sub-port's, else natural pad order."
                }
            },
            "required": [
                "id",
                "name",
                "occurrence",
                "connector",
                "pins"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "One export as the interface shows it."
        },
        "SystemObjectId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "description": "Id of an object in a system document: unique across the whole document and\nnever reused, even after the object is removed. Chosen by the caller or\nassigned by the server as `<prefix>_<10 base32>`."
        },
        "SystemLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "A human-readable name or label: 1 to 200 characters."
        },
        "Refdes": {
            "type": "string",
            "minLength": 1,
            "description": "Reference designator as KiCad resolves it for one symbol instance or\nfootprint, for example `R1`, `U3`, `#PWR01` or `R?`. Always a string. A\ncontract states whether it includes virtual (`#`) and unannotated (`?`)\nreferences."
        },
        "SystemSubPortRef": {
            "oneOf": [
                {
                    "$ref": "#/$defs/SystemOccurrenceSubPortRef",
                    "description": "One of this document's sub-ports."
                },
                {
                    "$ref": "#/$defs/SystemBoardSubPortRef",
                    "description": "A board-level sub-port."
                }
            ],
            "description": "Which sub-port of a connector an endpoint names."
        },
        "SystemEntryInterfacePin": {
            "type": "object",
            "properties": {
                "pad": {
                    "$ref": "#/$defs/PadNumber",
                    "description": "The pad on the export's site."
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The interface name: the export's `pinNames`, else the board's pin name, else the pad."
                },
                "net": {
                    "$ref": "#/$defs/SystemBundleNetId",
                    "description": "The system net the pin is on."
                },
                "signal": {
                    "type": "string",
                    "description": "That net's name; absent when the net has none."
                }
            },
            "required": [
                "pad",
                "name",
                "net"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "One pin of an exported connector or sub-port."
        },
        "SystemOccurrenceSubPortRef": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "occurrence",
                    "description": "Discriminator."
                },
                "id": {
                    "$ref": "#/$defs/SystemObjectId",
                    "description": "The sub-port's id in `subPorts`."
                }
            },
            "required": [
                "kind",
                "id"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "A sub-port stored in this document."
        },
        "SystemBoardSubPortRef": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "board",
                    "description": "Discriminator."
                },
                "id": {
                    "$ref": "#/$defs/SystemObjectId",
                    "description": "The board-level sub-port's id."
                },
                "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "The definition's version the user last saw. The live definition is always\nused; a newer one with different pins is a `board-sub-port-changed`\nfinding until `acknowledge-sub-port` (CONTRACTS.md §10.5)."
                }
            },
            "required": [
                "kind",
                "id",
                "version"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "A board-level sub-port, stored against the project and connector."
        },
        "PadNumber": {
            "type": "string",
            "description": "Pad or pin number as written in the file, always a string (`1`, `A1`,\n`EP`). Empty for a pad KiCad leaves unnumbered, such as a mechanical\nnon-plated hole."
        },
        "SystemBundleNetId": {
            "type": "string",
            "pattern": "^net-[0-9a-f]{16}$",
            "description": "A system net's id: `net-` and 16 lowercase hexadecimal digits."
        }
    }
}