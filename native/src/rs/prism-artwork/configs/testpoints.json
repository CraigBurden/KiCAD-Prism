{
  "schema": "prism.artwork.config.a0",
  "global": {
    "canvas": {
      "bounds": "board_and_bodies",
      "margin_mm": 1.0
    },
    "include_metadata": false,
    "show_empty_layers": false,
    "clip_to_outline": true,
    "clip_holes_from_copper": true,
    "mirror_bottom_view": true,
    "svg_scale": 10.0,
    "svg_size_unit": "mm",
    "clean_output": false,
    "styles": {
      "board_outline": {
        "enabled": true,
        "color": "#000000",
        "line_width_mm": 0.35
      },
      "board_cutouts": {
        "enabled": true,
        "color": "#000000",
        "hatch": false,
        "outline_style": "solid",
        "outline_width_mm": 0.35
      },
      "drills": {
        "enabled": true,
        "plated_color": "#FFFFFF",
        "non_plated_color": "#FFFFFF",
        "opacity": 1.0
      },
      "slots": {
        "enabled": true,
        "plated_color": "#FFFFFF",
        "non_plated_color": "#FFFFFF",
        "opacity": 1.0
      },
      "assembly_hlr": {
        "enabled": true,
        "color": "#000000",
        "line_width_mm": 0.25,
        "opacity": 1.0,
        "include_visible": true,
        "include_outline": true,
        "union_polygons": true
      },
      "assembly_designators": {
        "enabled": true,
        "color": "#000000",
        "box_fill_ratio": 0.8,
        "min_font_size_mm": 1.8,
        "max_font_size_mm": 2.5,
        "rotation_aspect_threshold": 1.5,
        "rotation_direction": "ccw",
        "opacity": 1.0
      },
      "pin1_marker": {
        "enabled": true,
        "color": "#000000",
        "dot_diameter_mm": 0.9,
        "pad_diameter_ratio": 0.6,
        "min_dot_diameter_mm": 0.6,
        "max_dot_diameter_mm": 1.2
      }
    }
  },
  "assembly": {
    "default_projection": "outline",
    "dnp_projection": "outline",
    "designator_color": "#000000",
    "dnp_designator_color": "#B00020"
  },
  "dnp": {
    "color": "#B00020",
    "hatch": true,
    "hatch_spacing_mm": 1.5,
    "hatch_angle_deg": 45.0,
    "hatch_line_width_mm": 0.18
  },
  "pin1": {
    "exclude_designators": [
      "R",
      "C"
    ],
    "exclude_single_pin": true
  },
  "components": {},
  "layer_outputs": {
    "enabled": false
  },
  "views": [
    {
      "name": "testpoint_top_view",
      "enabled": true,
      "group_id": "prism-testpoint-top",
      "output_svg": "views/{board}__testpoint_top_view.svg",
      "layers": [
        "BOARD_OUTLINE",
        "BOARD_CUTOUTS",
        "DRILLS",
        "SLOTS",
        "ASSEMBLY_DESIGNATORS_TOP",
        "ASSEMBLY_HLR_TOP"
      ],
      "assembly_hlr_mode": "outline",
      "styles": {
        "assembly_designators": {
          "font_weight": "700",
          "min_font_size_mm": 1.8,
          "max_font_size_mm": 2.5,
          "selector_overrides": {
            "*": {
              "enabled": false
            },
            "TP*": {
              "enabled": true
            }
          },
          "callout": true
        }
      }
    },
    {
      "name": "testpoint_bottom_view",
      "enabled": true,
      "group_id": "prism-testpoint-bottom",
      "output_svg": "views/{board}__testpoint_bottom_view.svg",
      "layers": [
        "BOARD_OUTLINE",
        "BOARD_CUTOUTS",
        "DRILLS",
        "SLOTS",
        "ASSEMBLY_DESIGNATORS_BOTTOM",
        "ASSEMBLY_HLR_BOTTOM"
      ],
      "assembly_hlr_mode": "outline",
      "styles": {
        "assembly_designators": {
          "font_weight": "700",
          "min_font_size_mm": 1.8,
          "max_font_size_mm": 2.5,
          "selector_overrides": {
            "*": {
              "enabled": false
            },
            "TP*": {
              "enabled": true
            }
          },
          "callout": true
        }
      }
    }
  ]
}
